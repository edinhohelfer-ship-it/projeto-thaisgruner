# Cloudflare Pages — Cache Headers
# Referência: https://developers.cloudflare.com/pages/configuration/headers/

# Imagens — cache máximo (1 ano), imutável
/imagens-home/*
  Cache-Control: public, max-age=31536000, immutable

/imagens-bio/*
  Cache-Control: public, max-age=31536000, immutable

/imagens-consultoria/*
  Cache-Control: public, max-age=31536000, immutable

/imagens-mentoria/*
  Cache-Control: public, max-age=31536000, immutable

/imagens-perfectlashes/*
  Cache-Control: public, max-age=31536000, immutable

/imagens-operacaoimpulse/*
  Cache-Control: public, max-age=31536000, immutable

/imagens-padrao/*
  Cache-Control: public, max-age=31536000, immutable

/imagens-saudeocular/*
  Cache-Control: public, max-age=31536000, immutable

/imagens-tricologia/*
  Cache-Control: public, max-age=31536000, immutable

/imagens-curso-tecnico/*
  Cache-Control: public, max-age=31536000, immutable

/imagens-ficha-anamnese/*
  Cache-Control: public, max-age=31536000, immutable

/imagens-financas/*
  Cache-Control: public, max-age=31536000, immutable

# Fontes — cache máximo (1 ano), imutável
/fontes-sitethais/*
  Cache-Control: public, max-age=31536000, immutable

# Assets compilados pelo Astro (hash no nome do arquivo — são imutáveis)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Favicon — 1 dia
/favicon.svg
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=86400

# Sitemap e robots — 1 dia
/sitemap.xml
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

# API routes — sem cache
/api/*
  Cache-Control: no-store, no-cache

# HTML (páginas) — revalidar sempre
/*
  Cache-Control: public, max-age=0, must-revalidate
