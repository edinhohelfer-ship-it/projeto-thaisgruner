---
const {
  destaque,
  titulo,
  itens,
  videoUrl,
  fundo = 'charcoal',
} = Astro.props;

// Extrai o ID do vídeo YouTube da URL de embed
const videoId = videoUrl.split('/embed/')[1]?.split('?')[0]?.split('/')[0] ?? '';
const thumbnailUrl = `https://img.youtube.com/vi/${videoId}/hqdefault.jpg`;
---

<section id="acesso" class={`acesso ${fundo === 'preto' ? 'acesso--preto' : ''} px-6 py-16 md:py-24 scroll-mt-[98px]`}>
  <div class="grid md:grid-cols-2 gap-10 md:gap-14 max-w-[1200px] mx-auto items-center">
    <div>
      <p class="titulo-livre-lovelace text-[18px] md:text-[26px] text-(--rose-gold) italic max-w-[500px]">
        {destaque}
      </p>
      <h3 class="texto-livre text-[16px] md:text-[19px] text-white mt-6">
        {titulo}
      </h3>
      <ul class="mt-5 space-y-3">
        {itens.map((item) => (
          <li class="flex items-start gap-3">
            <span class="acesso__icone">✓</span>
            <span class="texto-livre text-[13px] text-white opacity-80">{item}</span>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <div
        class="acesso__video acesso__facade"
        data-video-url={videoUrl}
        role="button"
        tabindex="0"
        aria-label="Reproduzir vídeo"
      >
        <img
          src={thumbnailUrl}
          alt="Pré-visualização do vídeo"
          class="acesso__thumb"
          width="480"
          height="360"
          loading="lazy"
          decoding="async"
        />
        <span class="acesso__play" aria-hidden="true">
          <svg width="68" height="48" viewBox="0 0 68 48" xmlns="http://www.w3.org/2000/svg">
            <path d="M66.5 7.5C65.7 4.7 63.5 2.5 60.8 1.7C55.4 0 34 0 34 0C34 0 12.6 0 7.2 1.7C4.5 2.5 2.3 4.7 1.5 7.5C0 12.9 0 24 0 24C0 24 0 35.1 1.5 40.5C2.3 43.3 4.5 45.5 7.2 46.3C12.6 48 34 48 34 48C34 48 55.4 48 60.8 46.3C63.5 45.5 65.7 43.3 66.5 40.5C68 35.1 68 24 68 24C68 24 68 12.9 66.5 7.5Z" fill="#FF0000"/>
            <path d="M27 34L45 24L27 14V34Z" fill="white"/>
          </svg>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .acesso__facade {
    position: relative;
    cursor: pointer;
    overflow: hidden;
    background: #000;
  }

  .acesso__thumb {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.2s;
  }

  .acesso__facade:hover .acesso__thumb {
    opacity: 0.85;
  }

  .acesso__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    transition: transform 0.2s;
  }

  .acesso__facade:hover .acesso__play {
    transform: translate(-50%, -50%) scale(1.1);
  }

  .acesso__facade iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
</style>

<script>
  document.querySelectorAll('.acesso__facade').forEach((el) => {
    const facade = el as HTMLElement;

    const ativar = () => {
      const videoUrl = facade.dataset.videoUrl ?? '';
      const separator = videoUrl.includes('?') ? '&' : '?';
      const iframe = document.createElement('iframe');
      iframe.src = videoUrl + separator + 'autoplay=1';
      iframe.title = 'Vídeo';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:none;';
      facade.innerHTML = '';
      facade.appendChild(iframe);
    };

    facade.addEventListener('click', ativar, { once: true });
    facade.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') ativar();
    }, { once: true });
  });
</script>
