---
const {
  texto,
  textoBotao,
  linkBotaoPrimario = '#',
} = Astro.props;
---

<section class="bg-white px-6 py-6 md:py-10 text-center">
  <p class="texto-livre-bold text-[16px] md:text-[20px] text-black mb-30">
    {texto}
  </p>
  <a href={linkBotaoPrimario} class="botao-base botao-pri-suave-rose">{textoBotao}</a>
</section>
