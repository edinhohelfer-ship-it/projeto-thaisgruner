---
const {
  texto,
  textoBotao,
  linkBotaoPrimario = '#',
  imagemFundo,
} = Astro.props;
---

<section class="bg-white relative overflow-hidden">
  <div class="relative w-[min(90%,1200px)] mx-auto overflow-hidden">
    {imagemFundo && (
      <img src={imagemFundo} alt="" class="absolute inset-0 w-full h-full object-cover object-[50%_50%]" />
    )}

    <div class="relative z-10 px-6 py-6 md:py-10 text-center">
      <p class="titulo-livre-lovelace-bold text-[12px] md:text-[20px] text-black mb-30">
        {texto}
      </p>
      <a href={linkBotaoPrimario} class="botao-base botao-pri-suave-rose">{textoBotao}</a>
    </div>
  </div>
</section>
