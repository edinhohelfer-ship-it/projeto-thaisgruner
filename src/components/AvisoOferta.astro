---
const {
  texto,
  textoApoio,
  textoBotao,
  linkBotaoPrimario = '#',
  imagemFundo,
  imagemFundoMobile,
  precoAntigo,
  precoNovo,
  tema = 'claro',
} = Astro.props;

const escuro = tema === 'escuro';
---

<section class={`aviso-oferta ${escuro ? 'aviso-oferta--escuro' : 'bg-white'} relative overflow-hidden`}>
  <div class="relative w-[min(90%,1200px)] mx-auto overflow-hidden">
    {imagemFundo && (
      <picture class="absolute inset-0 block w-full h-full">
        {imagemFundoMobile && (
          <source media="(max-width: 767px)" srcset={imagemFundoMobile} />
        )}
        <img src={imagemFundo} alt="" class="w-full h-full object-cover object-[50%_50%]" />
      </picture>
    )}

    <div class={`relative z-10 px-6 ${escuro ? 'py-10 md:py-16' : 'py-6 md:py-10'} text-center flex flex-col items-center`}>
      <p
        class={`titulo-livre-lovelace-bold text-[16px] md:text-[24px] ${escuro ? 'mb-8 md:mb-10 text-white' : 'mb-4 md:mb-6 text-black'}`}
        set:html={texto}
      />

      {textoApoio && (
        <p class={`texto-livre text-[14px] md:text-[20px] opacity-70 mb-10 whitespace-pre-line ${escuro ? 'text-white' : 'text-black'}`}>
          {textoApoio}
        </p>
      )}

      {(precoAntigo || precoNovo) && (
        <div class="aviso-oferta__preco-bloco">
          {precoAntigo && <span class="aviso-oferta__preco-antigo">De {precoAntigo}</span>}
          <span class="aviso-oferta__preco-por">por</span>
          {precoNovo && <span class="aviso-oferta__preco-novo">{precoNovo}</span>}
        </div>
      )}

      <a href={linkBotaoPrimario} class="botao-base botao-pri-suave-rose">{textoBotao}</a>
    </div>
  </div>
</section>