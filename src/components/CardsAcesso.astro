---
const {
  cards, // array de { titulo, imagem, imagemMobile, textoBotao, link }
} = Astro.props;
---

<section id="cursos" class="cards-acesso px-6 py-12 md:py-16 scroll-mt-[98px]">
  <div class="max-w-[900px] mx-auto grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-6">
    {cards.map((card) => (
      <div class="flex flex-col">
        <p class="titulo-livre-lovelace text-white text-[20px] md:text-[20px] text-center mb-2.5">
          {card.titulo}
        </p>
        <a href={card.link} class="cards-acesso__card aspect-auto md:aspect-[9/16] h-[140px] md:h-auto">
          <picture class="absolute inset-0 block w-full h-full">
            {card.imagemMobile && (
              <source media="(max-width: 767px)" srcset={card.imagemMobile} />
            )}
            <img src={card.imagem} alt={card.titulo} class="cards-acesso__imagem" />
          </picture>
          <span class="cards-acesso__texto text-white texto-livre text-[12px]">{card.textoBotao}</span>
        </a>
      </div>
    ))}
  </div>
</section>