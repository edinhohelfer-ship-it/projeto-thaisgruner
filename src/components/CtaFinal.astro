---
const {
  titulo,
  subtitulo,
  imagemFundo,
  imagemFundoMobile,
  textoBotaoPrimario,
  textoBotaoSecundario,
  linkBotaoPrimario = '#',
  linkBotaoSecundario = '#',
  fundo = 'preto',
} = Astro.props;
---

<section id="comprar" class={`cta-final ${fundo === 'branco' ? 'cta-final--branco' : ''} relative scroll-mt-[98px]`}>
  <div class="relative w-[min(90%,1200px)] mx-auto overflow-hidden">
    <picture class="absolute inset-0 block w-full h-full">
      {imagemFundoMobile && (
        <source media="(max-width: 767px)" srcset={imagemFundoMobile} />
      )}
      <img src={imagemFundo} alt="" class="cta-final__fundo w-full h-full object-cover object-[50%_50%]" />
    </picture>

    <div class="relative px-6 pt-6 pb-2 md:pb-6 flex flex-col items-center justify-end text-center min-h-[30svh] md:min-h-0 md:aspect-[21/9]">
      {titulo && (
        <h2 class="titulo-livre-lovelace text-[24px] md:text-[32px] text-(--rose-gold) mb-5 relative z-10">
          {titulo}
        </h2>
      )}
      {subtitulo && (
        <p class="titulo-livre-lovelace italic text-[14px] md:text-[16px] text-white opacity-80 mb-10 relative z-10">
          {subtitulo}
        </p>
      )}
      {(textoBotaoPrimario || textoBotaoSecundario) && (
        <div class="flex flex-col md:flex-row justify-center gap-3 relative z-10">
          {textoBotaoPrimario && <a href={linkBotaoPrimario} class="botao-base botao-pri-suave-rose">{textoBotaoPrimario}</a>}
          {textoBotaoSecundario && <a href={linkBotaoSecundario} class="botao-base botao-ter-suave-branco">{textoBotaoSecundario}</a>}
        </div>
      )}
    </div>
  </div>
</section>