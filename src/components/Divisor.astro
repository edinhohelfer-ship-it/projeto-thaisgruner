---
const {
  logo,
  texto,
} = Astro.props;
---

<div class="divisor px-6 py-5 gap-6 md:gap-8">
  <img src={logo} alt="Perfect Lashes" class="w-[50px] md:w-[60px]" />
  <p class="titulo-livre-lovelace text-[14px] md:text-[18px] text-(--rose-gold) italic text-center">
    {texto}
  </p>
  <img src={logo} alt="Perfect Lashes" class="w-[50px] md:w-[60px]" />
</div>