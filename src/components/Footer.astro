---
// Rodapé padrão de todas as páginas: marca, navegação, endereço do studio e contato.
// O endereço precisa ficar igual ao do Perfil da Empresa no Google.
const { tema = 'escuro' } = Astro.props;

const negocio = 'Thaís Grüner Beauty & Academy';
const endereco = {
  rua: 'Rua Thomaz Flores, 82',
  bairro: 'Centro',
  cidade: 'Santa Cruz do Sul',
  estado: 'RS',
  cep: '96810-038',
};
const linkMapa = 'https://www.google.com/maps/search/?api=1&query=' +
  encodeURIComponent(`${negocio}, ${endereco.rua}, ${endereco.cidade} - ${endereco.estado}`);

const schemaNegocio = {
  '@context': 'https://schema.org',
  '@type': 'BeautySalon',
  name: negocio,
  url: 'https://thaisgruner.com.br',
  image: 'https://thaisgruner.com.br/imagens-padrao/logothaisgruner.webp',
  address: {
    '@type': 'PostalAddress',
    streetAddress: endereco.rua,
    addressLocality: endereco.cidade,
    addressRegion: endereco.estado,
    postalCode: endereco.cep,
    addressCountry: 'BR',
  },
  hasMap: linkMapa,
  founder: { '@type': 'Person', name: 'Thaís Grüner' },
  sameAs: [
    'https://www.instagram.com/thaisgruner_',
    'https://www.youtube.com/@thaisgruner',
  ],
};
const ano = new Date().getFullYear();
---

<footer class={`site-footer site-footer--${tema}`}>
  <div class="site-footer__topo">
    <div class="site-footer__marca">
      <img src="/imagens-padrao/logothaisgruner.webp" alt={negocio} width="160" height="160" loading="lazy" decoding="async" class="site-footer__logo">
      <p>Cursos de extensão de cílios e mentoria para profissionais da beleza. Online ou presencial em Santa Cruz do Sul.</p>
    </div>

    <nav class="site-footer__nav" aria-label="Rodapé">
      <p class="site-footer__etiqueta">Navegue</p>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/mentoria">Mentoria</a></li>
        <li><a href="/curso-tecnico-perfect-lashes">Cursos técnicos</a></li>
        <li><a href="/perfect-lashes">Imersões</a></li>
      </ul>
    </nav>

    <div class="site-footer__studio">
      <p class="site-footer__etiqueta">Studio</p>
      <address class="site-footer__endereco">
        {negocio}<br>
        {endereco.rua} — {endereco.bairro}<br>
        {endereco.cidade} — {endereco.estado}<br>
        CEP {endereco.cep}
      </address>
      <a href={linkMapa} target="_blank" rel="noopener" class="site-footer__mapa">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.4"></circle></svg>
        Ver no mapa
      </a>
      <p class="site-footer__obs">Atendimento presencial com horário marcado</p>
    </div>

    <div class="site-footer__contato">
      <p class="site-footer__etiqueta">Contato</p>
      <a href="https://wa.me/5551995183025?text=Ol%C3%A1%20Tha%C3%ADs.%0AVim%20pelo%20site%20e%20gostaria%20de%20saber%20mais%20sobre%20os%20conte%C3%BAdos%20e%20acompanhamento!" target="_blank" rel="noopener" class="site-footer__fone">(51) 99518-3025</a>
      <span class="site-footer__sub">WhatsApp — cursos e mentoria</span>
      <div class="site-footer__social">
        <a href="https://wa.me/5551995183025?text=Ol%C3%A1%20Tha%C3%ADs.%0AVim%20pelo%20site%20e%20gostaria%20de%20saber%20mais%20sobre%20os%20conte%C3%BAdos%20e%20acompanhamento!" target="_blank" rel="noopener" class="social-icon" aria-label="WhatsApp">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
        <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2z" stroke="currentColor" stroke-width="1.3"></path>
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z" fill="currentColor"></path>
      </svg>
    </a>
        <a href="https://www.instagram.com/thaisgruner_?igsh=YWhrNWw4bWp0YWx0" target="_blank" rel="noopener" class="social-icon" aria-label="Instagram">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none"></circle></svg>
    </a>
        <a href="https://www.youtube.com/@thaisgruner" target="_blank" rel="noopener" class="social-icon" aria-label="YouTube">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><rect x="2" y="5" width="20" height="14" rx="4" fill="none" stroke="currentColor" stroke-width="1.6"></rect><polygon points="10,9 16,12 10,15"></polygon></svg>
    </a>
      </div>
    </div>
  </div>

  <div class="site-footer__base">
    <p class="site-footer__copy">© {ano} Thaís Grüner — Todos os direitos reservados</p>
  </div>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaNegocio)}></script>
</footer>
