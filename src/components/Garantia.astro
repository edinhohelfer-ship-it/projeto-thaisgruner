---
const {
  dias,
  subtitulo,
} = Astro.props;
---

<section class="garantia px-6 py-12 md:py-16 text-center">
  <div class="flex items-center justify-center gap-3 mb-4">
    <span class="garantia__selo titulo-livre-lovelace-bold text-[10px] text-(--charcoal)">SELO</span>
    <h2 class="titulo-livre-lovelace-bold text-[24px] text-(--charcoal) tracking-widest">GARANTIA</h2>
  </div>
  <hr class="garantia__linha my-6" />
  <p class="texto-livre-bold text-[21px] text-(--charcoal) mb-0">
    Garantia total de {dias} dias.
  </p>
  <hr class="garantia__linha my-6" />
  <p class="texto-livre text-[13px] text-(--charcoal) opacity-80 max-w-[500px] mx-auto">
    {subtitulo}
  </p>
</section>