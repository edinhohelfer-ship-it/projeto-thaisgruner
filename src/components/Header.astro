---
const { tema = 'escuro' } = Astro.props;
---

<header class={`site-header site-header--${tema}`}>
    <a href="/" class="shrink-0">
      <img src="/imagens-padrao/logothaisgruner.png" alt="Logo" class="h-[62.4px] w-auto">
    </a>
    <nav id="mobile-nav" class="site-header__nav">
      <ul class="flex flex-col md:flex-row items-end md:items-center gap-2 md:gap-10 py-3 md:py-0 text-right md:text-center pr-6 md:pr-0">
        <li><a href="/" class="nav-link titulo-livre-lovelace font-bold text-[13px] md:text-[16px] tracking-wider">Home</a></li>
        <li><a href="/mentoria" class="nav-link titulo-livre-lovelace font-bold text-[13px] md:text-[16px] tracking-wider">Mentoria</a></li>
        <li><a href="/consultoria" class="nav-link titulo-livre-lovelace font-bold text-[13px] md:text-[16px] tracking-wider">Consultoria</a></li>
        <li><a href="/perfect-lashes" class="nav-link titulo-livre-lovelace font-bold text-[13px] md:text-[16px] tracking-wider">Cursos Técnicos</a></li>
      </ul>
    </nav>
    <div class="site-header__actions">
      <!-- SUBSTITUIR pelo link real do WhatsApp quando disponível -->
      <a href="https://wa.me/5551995183025?text=Ol%C3%A1%20Tha%C3%ADs.%0AVim%20pelo%20site%20e%20gostaria%20de%20saber%20mais%20sobre%20os%20conte%C3%BAdos%20e%20acompanhamento!" target="_blank" rel="noopener" class="social-icon" aria-label="WhatsApp">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none">
          <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2z" stroke="currentColor" stroke-width="1.3"></path>
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z" fill="currentColor"></path>
        </svg>
      </a>
      <a href="https://www.instagram.com/thaisgruner_?igsh=YWhrNWw4bWp0YWx0" target="_blank" rel="noopener" class="social-icon" aria-label="Instagram">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none"></circle></svg>
      </a>
      <a href="https://www.youtube.com/@thaisgruner" target="_blank" rel="noopener" class="social-icon" aria-label="YouTube">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><rect x="2" y="5" width="20" height="14" rx="4" fill="none" stroke="currentColor" stroke-width="1.6"></rect><polygon points="10,9 16,12 10,15"></polygon></svg>
      </a>
      <button type="button" id="menu-toggle" class="site-header__menu-toggle social-icon" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-nav">
        <svg id="icon-hamburger" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        <svg id="icon-close" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display: none;"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg>
      </button>
    </div>
</header>

<script>
  (function () {
    var toggle = document.getElementById('menu-toggle');
    var nav = document.getElementById('mobile-nav');
    var iconHamburger = document.getElementById('icon-hamburger');
    var iconClose = document.getElementById('icon-close');

    toggle.addEventListener('click', function () {
      var isOpen = nav.classList.contains('is-open');
      if (isOpen) {
        nav.classList.remove('is-open');
        iconHamburger.style.display = '';
        iconClose.style.display = 'none';
        toggle.setAttribute('aria-expanded', 'false');
      } else {
        nav.classList.add('is-open');
        iconHamburger.style.display = 'none';
        iconClose.style.display = '';
        toggle.setAttribute('aria-expanded', 'true');
      }
    });
  })();
</script>
