---
const {
  titulo,
  texto,
  videoId,
  textoBotaoPrimario,
  linkBotaoPrimario,
  textoBotaoSecundario,
  linkBotaoSecundario,
} = Astro.props;
---

<section class="hero-cursos">

  <div class="w-full max-w-[1200px] flex flex-col items-center gap-10 mb-10">
    <h1 class="hero-cursos__titulo">{titulo}</h1>
    <p class="hero-cursos__copy" set:html={texto}></p>
  </div>

  <div class="w-full max-w-[780px] flex flex-col items-center gap-10">
    <div class="hero-cursos__video">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${videoId}?rel=0`}
        title={`Vídeo: ${titulo}`}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>

    <div class="flex flex-col gap-3 w-full md:flex-row md:w-auto md:gap-4">
      <a href={linkBotaoPrimario} class="botao-base botao-pri-padrao-terracota w-full md:w-auto">
        {textoBotaoPrimario}
      </a>
      <a href={linkBotaoSecundario} class="botao-base botao-ter-suave-rose w-full md:w-auto">
        {textoBotaoSecundario}
      </a>
    </div>
  </div>

</section>