---
const {
  titulo,
  texto,
  videoId,
  textoBotaoPrimario,
  linkBotaoPrimario,
  textoBotaoSecundario,
  linkBotaoSecundario,
  botaoPrimarioGlass = false,
  fundoTransparente = false,
} = Astro.props;

const thumbnailUrl = `https://img.youtube.com/vi/${videoId}/hqdefault.jpg`;
---

<section class={fundoTransparente ? "hero-cursos hero-cursos--transparente" : "hero-cursos"}>

  <div class="w-full max-w-[1200px] flex flex-col items-center gap-10 mb-10">
    <h1 class="hero-cursos__titulo animate-on-scroll fx" style="--d:.1s">{titulo}</h1>
    <p class="hero-cursos__copy animate-on-scroll fx" style="--d:.25s" set:html={texto}></p>
  </div>

  <div class="w-full max-w-[780px] flex flex-col items-center gap-10">
    <div
      class="hero-cursos__video hero-cursos__facade animate-on-scroll fx fx-slow"
      data-video-id={videoId}
      style="--d:.35s"
      role="button"
      tabindex="0"
      aria-label="Reproduzir vídeo"
    >
      <img
        src={thumbnailUrl}
        alt="Pré-visualização do vídeo"
        class="hero-cursos__thumb"
        width="480"
        height="360"
        loading="lazy"
        decoding="async"
      />
      <span class="hero-cursos__play" aria-hidden="true">
        <svg width="68" height="48" viewBox="0 0 68 48" xmlns="http://www.w3.org/2000/svg">
          <path d="M66.5 7.5C65.7 4.7 63.5 2.5 60.8 1.7C55.4 0 34 0 34 0C34 0 12.6 0 7.2 1.7C4.5 2.5 2.3 4.7 1.5 7.5C0 12.9 0 24 0 24C0 24 0 35.1 1.5 40.5C2.3 43.3 4.5 45.5 7.2 46.3C12.6 48 34 48 34 48C34 48 55.4 48 60.8 46.3C63.5 45.5 65.7 43.3 66.5 40.5C68 35.1 68 24 68 24C68 24 68 12.9 66.5 7.5Z" fill="#FF0000"/>
          <path d="M27 34L45 24L27 14V34Z" fill="white"/>
        </svg>
      </span>
    </div>

    <div class="flex flex-col gap-3 w-full md:flex-row md:w-auto md:gap-4 animate-on-scroll fx" style="--d:.5s">
      {botaoPrimarioGlass ? (
        <a
          class="group isolate inline-flex cursor-pointer overflow-hidden transition-all duration-300 hover:scale-105 hover:shadow-[0_0_50px_10px_rgba(176,108,74,0.45)] bg-gradient-to-b from-white/20 via-white/0 to-white/5 rounded-full relative shadow-[0_0_25px_rgba(176,108,74,0.3),0_8px_40px_rgba(176,108,74,0.15)] w-full md:w-auto justify-center"
          href={linkBotaoPrimario}
        >
          <div class="absolute inset-0 overflow-hidden rounded-full">
            <div
              class="absolute inset-[-100%] w-[300%] h-[300%] left-[-100%] top-[-100%] animate-[spin_3s_linear_infinite]"
              style="background:conic-gradient(from 0deg,transparent 0deg,transparent 80deg,rgba(204,177,158,0.8) 180deg,transparent 280deg,transparent 360deg)"
            ></div>
          </div>
          <div class="absolute inset-[1px] rounded-full backdrop-blur-xl z-0 bg-neutral-950/90"></div>
          <div class="z-10 flex gap-3 overflow-hidden text-sm font-medium text-white rounded-full py-3 pr-5 pl-4 relative items-center">
            <div
              class="relative z-20 w-7 h-7 rounded-full flex items-center justify-center ring-1 ring-white/20 group-hover:scale-110 transition-transform duration-300"
              style="background:linear-gradient(to bottom,#CCB19E,#B06C4A);box-shadow:0 4px 12px rgba(176,108,74,0.3)"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
                <path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/>
              </svg>
            </div>
            <span class="whitespace-nowrap relative z-10 font-medium tracking-tight text-base text-white/95 group-hover:text-white transition-colors">
              {textoBotaoPrimario}
            </span>
            <span class="inline-flex items-center justify-center z-10 bg-white/10 w-6 h-6 rounded-full ml-1 relative group-hover:translate-x-0.5 transition-transform text-white/80 group-hover:text-white">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </span>
          </div>
        </a>
      ) : (
        <a href={linkBotaoPrimario} class="botao-base botao-pri-padrao-terracota w-full md:w-auto">
          {textoBotaoPrimario}
        </a>
      )}
      {textoBotaoSecundario && (
        <a href={linkBotaoSecundario} class="botao-base botao-ter-suave-rose w-full md:w-auto">
          {textoBotaoSecundario}
        </a>
      )}
    </div>
  </div>

</section>

<script>
  (function () {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0 });
    document.querySelectorAll('.hero-cursos .animate-on-scroll').forEach(function (el) {
      io.observe(el);
    });
  })();
</script>

<script>
  document.querySelectorAll('.hero-cursos__facade').forEach(function (el) {
    var facade = el;
    function ativar() {
      var videoId = facade.dataset.videoId;
      var iframe = document.createElement('iframe');
      iframe.src = 'https://www.youtube-nocookie.com/embed/' + videoId + '?rel=0&autoplay=1';
      iframe.title = 'Vídeo';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      facade.innerHTML = '';
      facade.appendChild(iframe);
    }
    facade.addEventListener('click', ativar, { once: true });
    facade.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') ativar();
    }, { once: true });
  });
</script>