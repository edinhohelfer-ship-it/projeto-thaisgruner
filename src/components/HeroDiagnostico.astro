---
const {
  titulo,
  texto,
  textoBotao,
  imagemFundo,
} = Astro.props;
---

<section class="hero-diagnostico relative">
  <div class="relative min-h-[60svh] md:min-h-[80svh] w-[min(90%,1200px)] mx-auto overflow-hidden">
    <img src={imagemFundo} alt="" class="hero-diagnostico__fundo object-[50%_0%]" />

    <div class="absolute left-0 right-0 top-[5%] h-[25%] flex flex-col items-center justify-center text-center px-6">
      <h2 class="titulo-livre-lovelace text-[24px] md:text-[32px] text-(--charcoal) mb-3">
        {titulo}
      </h2>
      <p class="texto-livre text-[13px] md:text-[15px] text-(--charcoal) opacity-80 max-w-[500px] mb-5">
        {texto}
      </p>
      <a href="#" class="botao-base botao-pri-padrao-rose">{textoBotao}</a>
    </div>
  </div>
</section>