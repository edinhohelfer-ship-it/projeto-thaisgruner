---
const {
  badge,
  logo,
  titulo,
  texto,
  textoBotaoPrimario,
  textoBotaoSecundario,
  linkBotaoPrimario = '#',
  linkBotaoSecundario = '#',
  imagemFundo,
} = Astro.props;
---

<section class="hero-overlay relative">
  <div class="relative min-h-[50svh] md:min-h-0 md:aspect-[16/9] w-[min(90%,1200px)] mx-auto flex flex-col items-start overflow-hidden">
    <img src={imagemFundo} alt="" class="absolute inset-0 w-full h-full object-cover object-[60%_30%] md:object-[40%_50%]" />

    <div class="relative w-full min-w-0 grid md:grid-cols-2 pt-4 md:pt-30">
      <div class="w-7/10 md:w-full min-w-0 flex flex-col items-start px-2 md:px-0">
        <span class="texto-livre text-[16px] md:text-[16px] text-(--rose-gold)">{badge}</span>
        <img src={logo} alt="Perfect Lashes" class="w-[120px] md:w-[180px] h-auto mt-2" />
        <h1 class="titulo-livre-lovelace text-[22px] md:text-[40px] text-white mt-4">{titulo}</h1>
        <p class="texto-livre text-[14px] md:text-[16px] text-white opacity-75 mt-8">{texto}</p>
      </div>
    </div>

    <!-- Botões sobrepostos: só no desktop -->
    {(textoBotaoPrimario || textoBotaoSecundario) && (
      <div class="hidden md:flex absolute bottom-[8%] left-0 w-1/2 flex-row justify-center gap-3">
        {textoBotaoPrimario && <a href={linkBotaoPrimario} class="botao-base botao-pri-suave-rose">{textoBotaoPrimario}</a>}
        {textoBotaoSecundario && <a href={linkBotaoSecundario} class="botao-base botao-ter-suave-branco">{textoBotaoSecundario}</a>}
      </div>
    )}

    <!-- Botões abaixo da imagem: só no mobile -->
    {(textoBotaoPrimario || textoBotaoSecundario) && (
      <div class="hero-overlay__botoes-mobile relative z-10 w-full flex md:hidden flex-col items-center gap-3 px-6 py-8">
        {textoBotaoPrimario && <a href={linkBotaoPrimario} class="botao-base botao-pri-suave-rose w-full">{textoBotaoPrimario}</a>}
        {textoBotaoSecundario && <a href={linkBotaoSecundario} class="botao-base botao-ter-suave-branco w-full">{textoBotaoSecundario}</a>}
      </div>
    )}
  </div>
</section>