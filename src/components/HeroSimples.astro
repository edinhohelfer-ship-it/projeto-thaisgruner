---
const {
  titulo,
  texto,
  textoBotao,
  link,
  imagemFundo,
} = Astro.props;
---

<section class="hero-simples relative overflow-hidden">
  <div class="relative w-[min(90%,1200px)] mx-auto overflow-hidden min-h-[70svh] md:min-h-[80svh]">
    <img src={imagemFundo} alt="" class="absolute inset-0 w-full h-full object-cover object-[50%_50%]" />

    <div class="absolute left-0 right-0 top-1/2 bottom-0 flex flex-col items-center justify-center text-center px-6">
      <h1 class="titulo-livre-lovelace text-[24px] md:text-[32px] text-white mb-3 md:mb-4">
        {titulo}
      </h1>
      <p class="texto-livre text-[13px] md:text-[15px] text-(--rose-gold) max-w-[460px] mb-5 md:mb-6">
        {texto}
      </p>
      <a href={link} class="botao-base botao-pri-padrao-rose">{textoBotao}</a>
    </div>
  </div>
</section>