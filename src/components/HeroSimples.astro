---
const {
  tituloTopo,
  titulo,
  texto,
  textoBotao,
  link,
  imagemFundo,
  corTitulo = 'var(--rose-gold)',
  corTexto = '#FFFFFF',
} = Astro.props;
---

<section class="hero-simples relative overflow-hidden">
  <div class="relative w-[min(90%,1200px)] mx-auto overflow-hidden min-h-[70svh] md:min-h-[80svh]">
    <img src={imagemFundo} alt="" class="absolute inset-0 w-full h-full object-cover object-[50%_50%]" />

    <div class="absolute left-0 right-0 top-2/5 bottom-0 flex flex-col items-center justify-center text-center px-6">
      {tituloTopo && (
        <p class="titulo-livre-lovelace-bold text-[40px] md:text-[60px] mb-1" style={`color: ${corTitulo};`}>
          {tituloTopo}
        </p>
      )}

      <h1 class="titulo-livre-lovelace-bold text-[16px] md:text-[32px] mb-2 md:mb-4" style={`color: ${corTitulo};`}>
        {titulo}
      </h1>
      <p class="texto-livre text-[12px] md:text-[15px] max-w-[460px] mb-8 md:mb-6" style={`color: ${corTexto};`}>
        {texto}
      </p>
      <a href={link} class="botao-base botao-pri-suave-rose">{textoBotao}</a>
    </div>
  </div>
</section>