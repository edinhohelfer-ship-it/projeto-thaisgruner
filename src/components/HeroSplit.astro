---
const {
  tema = 'claro',
  badge,
  titulo,
  tituloDestaque,
  tituloFinal,
  texto,
  textoBotaoPrimario,
  textoBotaoSecundario,
  microtexto,
  imagem,
} = Astro.props;
---

<section class={`hero-split min-h-[80svh] flex items-center hero-split--${tema}`}>
  <div class="w-[min(90%,1200px)] mx-auto grid md:grid-cols-2">
    <div class="contents md:flex md:order-1 md:flex-col md:justify-start md:items-start md:text-left md:px-12 md:py-24">
      <span class="hero-split__badge texto-livre order-1 md:order-none justify-self-center w-auto inline-block text-[11px] uppercase tracking-widest px-4 py-1.5 rounded-lg border mb-6 mx-6 md:mx-0 mt-4 md:mt-0" style="border-color: rgba(50, 49, 57, 0.35); background-color: rgba(255, 255, 255, 0.25);">
        {badge}
      </span>
      <h1 class="hero-split__titulo order-2 md:order-none text-3xl md:text-5xl mb-5 w-full px-6 md:px-0 md:mx-0 text-center md:text-left">
        <span class="titulo-livre-lovelace text-[22px]">{titulo}</span> <em class="hero-split__destaque titulo-medio-bold-italic">{tituloDestaque}</em><span class="titulo-livre-lovelace text-[22px]">{tituloFinal}</span>
      </h1>
      <p class="hero-split__texto texto-livre text-[12px] order-4 md:order-none w-full mb-8 px-6 md:px-0 md:mx-0 text-center md:text-left mt-2 md:mt-0">
        {texto}
      </p>
      <div class="order-5 md:order-none w-full flex flex-wrap md:flex-nowrap gap-4 mb-4 px-6 md:px-0 md:mx-0 justify-center md:justify-start">
        <a href="#" class="botao-base botao-pri-padrao-charcoal">
          {textoBotaoPrimario}
        </a>
        <a href="#" class="botao-base botao-sec-padrao-charcoal">
          {textoBotaoSecundario}
        </a>
      </div>
      <p class="hero-split__microtexto texto-livre text-[12px] order-6 md:order-none text-xs opacity-60 mx-6 md:mx-0 text-center pb-10 md:pb-0">
        {microtexto}
      </p>
    </div>
    <div class="order-3 md:order-2 flex items-center justify-center px-6 py-2 md:items-end md:justify-center md:pt-16 md:pb-5">
      <div class="w-full max-w-[400px] aspect-[4/5] md:max-w-[540px] md:aspect-[540/720] rounded-lg overflow-hidden mx-auto">
        <img src={imagem} alt={titulo} class="w-full h-full object-cover">
      </div>
    </div>
  </div>
</section>