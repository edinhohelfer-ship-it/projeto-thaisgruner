---
const {
  titulo,
  texto,
  textoBotaoPrimario,
  textoBotaoSecundario,
  linkBotaoPrimario = '#',
  linkBotaoSecundario = '#',
  imagemFundo,
  imagemFundoMobile,
  imagemSobreposta,
} = Astro.props;
---

<section class="hero-split-overlay relative min-h-[80svh] md:min-h-0 md:aspect-[16/9] flex flex-col items-start overflow-hidden">
  <picture class="absolute inset-0 block w-full h-full">
    {imagemFundoMobile && (
      <source media="(max-width: 767px)" srcset={imagemFundoMobile} />
    )}
    <img src={imagemFundo} alt="" class="w-full h-full object-cover object-[50%_50%]" />
  </picture>

  <!-- ===== VERSÃO MOBILE ===== -->
  <div class="md:hidden relative w-[min(90%,1200px)] mx-auto min-w-0 flex flex-col items-center text-center px-6 py-10">
    {imagemSobreposta && (
      <div class="w-[65%] aspect-[4/5] rounded-lg overflow-hidden mb-6">
        <img src={imagemSobreposta} alt={titulo} class="w-full h-full object-cover" />
      </div>
    )}

    <h1 class="hero-split-overlay__titulo titulo-livre-lovelace text-[24px] mb-3">
      {titulo}
    </h1>
    <p class="hero-split-overlay__texto texto-livre text-[13px] opacity-80 mb-6 max-w-[380px]">
      {texto}
    </p>

    <div class="relative z-10 w-full flex flex-col gap-3">
      <a href={linkBotaoPrimario} class="botao-base botao-pri-suave-rose w-full">{textoBotaoPrimario}</a>
      <a href={linkBotaoSecundario} class="botao-base botao-ter-suave-rose w-full">{textoBotaoSecundario}</a>
    </div>
  </div>

  <!-- ===== VERSÃO DESKTOP ===== -->
  <div class="hidden md:grid relative w-[min(90%,1200px)] mx-auto min-w-0 md:grid-cols-2 items-center py-16">
    <div class="min-w-0 flex flex-col items-start text-left pr-10">
      <h1 class="hero-split-overlay__titulo titulo-livre-lovelace text-[36px] mb-4">
        {titulo}
      </h1>
      <p class="hero-split-overlay__texto texto-livre text-[15px] opacity-80 mb-8 max-w-[420px]">
        {texto}
      </p>

      <div class="flex flex-row gap-4">
        <a href={linkBotaoPrimario} class="botao-base botao-pri-suave-rose">{textoBotaoPrimario}</a>
        <a href={linkBotaoSecundario} class="botao-base botao-ter-suave-rose">{textoBotaoSecundario}</a>
      </div>
    </div>

    <div class="flex justify-center">
      {imagemSobreposta && (
        <div class="w-[280px] aspect-[4/5] rounded-lg overflow-hidden">
          <img src={imagemSobreposta} alt={titulo} class="w-full h-full object-cover" />
        </div>
      )}
    </div>
  </div>
</section>