---
const {
  tituloGrande,
  tituloMedio,
  texto,
  imagemFundo,
} = Astro.props;
---

<section class="secao-textos-direita relative overflow-hidden">
  <img src={imagemFundo} alt="" class="absolute inset-0 w-full h-full object-cover object-[50%_50%]" />

  <div class="relative w-[min(90%,1200px)] mx-auto grid md:grid-cols-2 py-16 md:py-24">
    <div></div>

    <div class="flex flex-col items-start text-left px-6 md:px-0">
      <h2 class="titulo-livre-lovelace-bold text-(--charcoal) text-[26px] md:text-[36px] mb-2">
        {tituloGrande}
      </h2>
      <h3 class="titulo-livre-lovelace-italic text-(--charcoal) text-[18px] md:text-[24px] mb-4">
        {tituloMedio}
      </h3>
      <p class="texto-livre text-(--charcoal) text-[14px] md:text-[15px] opacity-90 max-w-[460px]">
        {texto}
      </p>
    </div>
  </div>
</section>