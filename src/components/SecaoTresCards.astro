---
const {
  titulo,
  cards, // array de strings, um por card
} = Astro.props;
---

<section class="secao-tres-cards px-6 py-16 md:py-20">
  <div class="w-[min(90%,1200px)] mx-auto text-center">
    <h2 class="titulo-livre-lovelace-bold text-(--charcoal) text-[22px] md:text-[28px] mb-4">
      {titulo}
    </h2>

    <hr class="secao-tres-cards__linha mx-auto mb-10 md:mb-14" />

    <div class="flex flex-col md:flex-row justify-center gap-[3.5%] md:gap-[4.16%]">
      {cards.map((cardTexto) => (
        <div class="secao-tres-cards__card w-full md:w-[25%] h-[90px] md:h-auto md:aspect-square flex items-center justify-center p-4">
          <p class="texto-livre text-(--charcoal) text-[13px] text-center">
            {cardTexto}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>