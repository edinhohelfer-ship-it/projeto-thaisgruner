---
const {
  titulo,
  cards, // array de objetos: { titulo, descricao, horas }
} = Astro.props;
---

<section class="secao-tres-cards px-6 py-16 md:py-20">
  <div class="w-[min(90%,1200px)] mx-auto text-center">
    <h2 class="titulo-livre-lovelace-bold text-(--charcoal) text-[22px] md:text-[28px] mb-4">
      {titulo}
    </h2>

    <hr class="secao-tres-cards__linha mx-auto mb-10 md:mb-14" />

    <div class="flex flex-col md:flex-row justify-center gap-[3.5%] md:gap-[4.16%]">
      {cards.map((card) => (
        <div class="secao-tres-cards__card w-full md:w-[25%] text-left p-6 md:p-8">
          <h3 class="secao-tres-cards__card-titulo">{card.titulo}</h3>
          <hr class="secao-tres-cards__card-divisor" />
          <p class="secao-tres-cards__card-descricao">{card.descricao}</p>
          <div class="secao-tres-cards__card-horas">{card.horas}</div>
        </div>
      ))}
    </div>
  </div>
</section>