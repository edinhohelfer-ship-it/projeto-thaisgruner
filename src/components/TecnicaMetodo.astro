---
const {
  frase,
  texto,
  beneficios, // array de { imagem, texto }
} = Astro.props;
---

<section class="tecnica-metodo px-6 py-16 md:py-24">
  <div class="tecnica-metodo__frame max-w-[600px] mx-auto px-6 py-6 md:px-10 md:py-8">
    <p class="titulo-livre-lovelace text-[20px] md:text-[26px] text-(--rose-gold) italic">{frase}</p>
  </div>

  <p class="texto-livre text-[13px] md:text-[14px] text-white opacity-80 text-center max-w-[560px] mx-auto mt-8">
    {texto}
  </p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10 max-w-[900px] mx-auto mt-12 md:mt-14">
    {beneficios.map((item) => (
      <div class="flex items-center gap-4 md:gap-5">
        <img src={item.imagem} alt="" class="tecnica-metodo__circulo w-[64px] h-[64px] md:w-[80px] md:h-[80px]" />
        <p class="texto-livre text-[13px] md:text-[14px] text-white opacity-80">{item.texto}</p>
      </div>
    ))}
  </div>
</section>