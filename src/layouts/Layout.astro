---
import '../styles/global.css';
import '../styles/estilos-compartilhados.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';

const {
  temaHeader = 'escuro',
  temaFooter = 'escuro',
  metaViewContent = null,
  metaValue = null,
  metaCurrency = 'BRL',
  // SEO
  titulo = 'Thaís Grüner',
  descricao = 'Mentorias, consultorias e treinamentos para profissionais da beleza que desejam estruturar seus negócios, evoluir com estratégia e crescer de forma eficiente.',
  ogImagem = 'https://thaisgruner.com.br/imagens-padrao/thais-gruner.webp',
  canonical = Astro.url.href,
} = Astro.props;

const tituloCompleto = titulo === 'Thaís Grüner'
  ? 'Thaís Grüner — Mentorias e Treinamentos para Profissionais da Beleza'
  : `${titulo} | Thaís Grüner`;
---

<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="facebook-domain-verification" content="w2jqq8tq49e5oiwl3sue4sykxk6naz" />

		<title>{tituloCompleto}</title>
		<meta name="description" content={descricao} />
		<link rel="canonical" href={canonical} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={tituloCompleto} />
		<meta property="og:description" content={descricao} />
		<meta property="og:image" content={ogImagem} />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:site_name" content="Thaís Grüner" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={tituloCompleto} />
		<meta name="twitter:description" content={descricao} />
		<meta name="twitter:image" content={ogImagem} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<slot name="head" />
	</head>
	<body class="bg-black">
    <Header tema={temaHeader} />
    <main style="padding-top: var(--altura-header);">
        <slot />
    </main>
    <Footer tema={temaFooter} />

    <CookieConsent />

    <script define:vars={{ metaViewContent, metaValue, metaCurrency }}>
        window.__metaViewContent = metaViewContent;
        window.__metaValue = metaValue;
        window.__metaCurrency = metaCurrency;
    </script>

    <script>
      import { initMetaPixel, trackMetaEvent } from '../scripts/meta-pixel.js';
      import { initGoogleAds } from '../scripts/google-ads.js';
      import { initTikTokPixel } from '../scripts/tiktok-pixel.js';
      import { initTrackClicks } from '../scripts/track-clicks.js';

      initMetaPixel();
      initGoogleAds();
      initTikTokPixel();
      initTrackClicks();

    const metaViewContent = window.__metaViewContent;
    const metaValue = window.__metaValue;
    const metaCurrency = window.__metaCurrency;


        if (metaViewContent) {
        const eventId =
            window.crypto && window.crypto.randomUUID
            ? window.crypto.randomUUID()
            : 'evt-' + Date.now() + '-' + Math.random().toString(36).slice(2);

        const customData = { content_name: metaViewContent };
        if (metaValue) {
            customData.value = metaValue;
            customData.currency = metaCurrency;
        }

        trackMetaEvent('ViewContent', customData, eventId);

        fetch('/api/track-event', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
            event_name: 'ViewContent',
            event_id: eventId,
            event_source_url: window.location.href,
            custom_data: customData,
            }),
        }).catch(() => {});
        }

    </script>
	</body>

</html>
