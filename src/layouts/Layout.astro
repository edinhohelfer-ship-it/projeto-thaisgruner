---
import '../styles/global.css';
import '../styles/estilos-compartilhados.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';

const { temaHeader = 'escuro', temaFooter = 'escuro', metaViewContent = null } = Astro.props;
---

<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Thaís Grüner</title>
	</head>
	<body class="bg-black">
    <Header tema={temaHeader} />
    <main style="padding-top: var(--altura-header);">
        <slot />
    </main>
    <Footer tema={temaFooter} />

    <CookieConsent />

    <script define:vars={{ metaViewContent }}>
      window.__metaViewContent = metaViewContent;
    </script>

    <script>
      import { initMetaPixel, trackMetaEvent } from '../scripts/meta-pixel.js';
      import { initGoogleAds } from '../scripts/google-ads.js';
      import { initTikTokPixel } from '../scripts/tiktok-pixel.js';
      import { initTrackClicks } from '../scripts/track-clicks.js';

      initMetaPixel();
      initGoogleAds();
      initTikTokPixel();
      initTrackClicks();

      const metaViewContent = window.__metaViewContent;

      if (metaViewContent) {
        const eventId =
          window.crypto && window.crypto.randomUUID
            ? window.crypto.randomUUID()
            : 'evt-' + Date.now() + '-' + Math.random().toString(36).slice(2);

        trackMetaEvent('ViewContent', { content_name: metaViewContent }, eventId);

        fetch('/api/track-event', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            event_name: 'ViewContent',
            event_id: eventId,
            event_source_url: window.location.href,
            custom_data: { content_name: metaViewContent },
          }),
        }).catch(() => {});
      }
    </script>
	</body>

</html>