---
import Layout from '../layouts/Layout.astro';
import HeroSplitOverlay from '../components/HeroSplitOverlay.astro';
import SecaoTresCards from '../components/SecaoTresCards.astro';
import SecaoTextosDireita from '../components/SecaoTextosDireita.astro';
import TecnicaMetodo from '../components/TecnicaMetodo.astro';
import AvisoOferta from '../components/AvisoOferta.astro';
import Depoimentos from '../components/Depoimentos.astro';
import SobreThais from '../components/SobreThais.astro';
import { sobreThaisDados } from '../dados/sobreThais.js';
import Garantia from '../components/Garantia.astro';
import CtaFinal from '../components/CtaFinal.astro';
---

<Layout temaHeader="claro" temaFooter="claro">

  <HeroSplitOverlay
    titulo="Transforme sua carreira através do Perfect Lashes"
    texto="Muito além de um curso que só te ensina a colar fios, aqui você encontrará um conteúdo diferenciado que te mostra tudo o que você precisa para ser uma Lash Designer bem sucedida. Não apenas uma Lash, uma Perfect Lash!"
    textoBotaoPrimario="Quero ser uma Perfect Lash"
    textoBotaoSecundario="Conheça o conteúdo"
    linkBotaoPrimario="#pagamento"
    linkBotaoSecundario="#conteudo"
    imagemFundo="/imagens-curso-tecnico/hero-fundo-curso-tecnico.png"
    imagemSobreposta="/imagens-curso-tecnico/hero-destaque-curso-tecnico.png"
  />


<SecaoTresCards
  titulo="Título da Seção"
  cards={[
    "Texto do card 1 aqui, centralizado",
    "Texto do card 2 aqui, centralizado",
    "Texto do card 3 aqui, centralizado",
  ]}
/>


<SecaoTextosDireita
  tituloGrande="Título Grande"
  tituloMedio="Título Médio"
  texto="Texto de apoio explicando o conteúdo desta seção, alinhado à esquerda dentro da metade direita da tela."
  imagemFundo="/imagens-curso-tecnico/fundo-textos-direita.png"
/>


<TecnicaMetodo
  frase="Muito além de um curso que só te ensina a colar fios!"
  texto="Um conteúdo diferenciado que te mostra tudo o que você precisa para ser uma Lash Designer bem sucedida, com técnica de excelência e um negócio estruturado."
  fundo="charcoal"
  beneficios={[
    { imagem: "/imagens-curso-tecnico/icone-01.png", texto: "Extensão de Cílios — como surgiu o procedimento, evolução dos materiais e curiosidades." },
    { imagem: "/imagens-curso-tecnico/icone-02.png", texto: "Saúde e Segurança — saúde ocular, anatomia dos cílios, contraindicações e biossegurança." },
    { imagem: "/imagens-curso-tecnico/icone-03.png", texto: "Harmonização — visagismo aplicado, lash mapping e formatos de olhos." },
    { imagem: "/imagens-curso-tecnico/icone-04.png", texto: "Técnica — volumes clássico e tecnológico, manutenções e remoções." },
    { imagem: "/imagens-curso-tecnico/icone-05.png", texto: "Materiais — fios sintéticos, acessórios e adesivos profissionais." },
    { imagem: "/imagens-curso-tecnico/icone-06.png", texto: "Atendimento — ficha de avaliação, cuidados pré e pós procedimento." },
    { imagem: "/imagens-curso-tecnico/icone-07.png", texto: "Seu Negócio — dicas de fotografia, precificação e marketing." },
  ]}
/>


<AvisoOferta
  texto="ESTA OFERTA TERMINARÁ EM BREVE."
  textoBotao="Comprar agora"
  imagemFundo="/imagens-curso-tecnico/fundo-oferta.png"
/>


<Depoimentos
  titulo="A experiência Perfect Lashes"
  depoimentos={[
    { foto: "/imagens-curso-tecnico/depo-card-01.png", nome: "Aluna 1", texto: "Depoimento real da aluna aqui." },
    { foto: "/imagens-curso-tecnico/depo-card-02.png", nome: "Aluna 2", texto: "Depoimento real da aluna aqui." },
    { foto: "/imagens-curso-tecnico/depo-card-03.png", nome: "Aluna 3", texto: "Depoimento real da aluna aqui." },
    { foto: "/imagens-curso-tecnico/depo-card-04.png", nome: "Aluna 4", texto: "Depoimento real da aluna aqui." },
  ]}
/>


<SobreThais {...sobreThaisDados} />


<Garantia
  dias="7"
  subtitulo="Se você assistir às aulas, pôr em prática e mesmo assim achar que o curso não é para você, é só entrar em contato e a gente devolve seu dinheiro."
/>


<CtaFinal
  titulo="Sua carreira como Lash Designer começa agora"
  subtitulo="Não apenas uma Lash, uma Perfect Lash!"
  imagemFundo="/imagens-curso-tecnico/cta-final-curso-tecnico.png"
  textoBotaoPrimario="Quero ser uma Perfect Lash"
  linkBotaoPrimario="https://pay.hotmart.com/O82390636C"
  fundo="preto"
/>




</Layout>