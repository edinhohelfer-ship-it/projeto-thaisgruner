---
import Layout from '../layouts/Layout.astro';
import HeroCursos from '../components/HeroCursos.astro';
import SecaoTresCards from '../components/SecaoTresCards.astro';
import AvisoOferta from '../components/AvisoOferta.astro';
import SobreThais from '../components/SobreThais.astro';
import { sobreThaisDados } from '../dados/sobreThais.js';
import Garantia from '../components/Garantia.astro';
import CtaFinal from '../components/CtaFinal.astro';
---

<Layout temaHeader="claro" temaFooter="claro" metaViewContent="Curso Técnico Perfect Lashes">



  <HeroCursos
  titulo="Você está no lugar certo."
   texto={`Ser lash designer dá sim um bom dinheiro mas para quem trabalha certo. Mas eu não vou te ajudar. <span class="hero-cursos__destaque">Eu vou mudar a sua vida.</span> Só depende de você acreditar e dar o próximo passo.`}
  videoId="jKK-OIEIAbo"
  textoBotaoPrimario="Garantir meu combo"
  linkBotaoPrimario="https://pay.hotmart.com/LINK_DO_COMBO"
  textoBotaoSecundario="Falar com a Thaís"
  linkBotaoSecundario="https://wa.me/5551995183025"
/>



<SecaoTresCards
  titulo="Tudo que você vai aprender"
  cards={[
    {
      titulo: "Técnico",
      descricao: "Teoria, treinos, práticas, aplicação, remoção e manutenções. O conteúdo mais completo do mercado. Volumes Clássico — Tecnológicos — Híbridos e Russo.",
      horas: "Total: 9 horas aula",
    },
    {
      titulo: "Avançados e Exclusivos",
      descricao: "Tricologia dos cílios, Saúde Ocular, Biossegurança e Fichas de anamnese pronta e personalizável.",
      horas: "Total: 6 horas aula",
    },
    {
      titulo: "Negócio Lucrativo",
      descricao: "Estratégias para captar e conquistar clientes, Financeiro completo para você cobrar certo e ganhar dinheiro de verdade com o seu trabalho.",
      horas: "Total: 5 horas aula",
    },
  ]}
/>


<AvisoOferta
  texto={`Todos os meus cursos Perfect Lashes em um único acesso. É a sua chance de <span class="aviso-oferta__destaque">mudar de vida agora!</span>`}
  textoBotao="Comprar agora"
  linkBotaoPrimario="https://pay.hotmart.com/LINK_DO_COMBO"
  precoAntigo="R$ 1.980,00"
  precoNovo="R$ 197,00"
  tema="escuro"
/>



<SobreThais {...sobreThaisDados} />


<Garantia
  dias="7"
  subtitulo="Se você assistir às aulas, pôr em prática e mesmo assim achar que o curso não é para você, é só entrar em contato e a gente devolve seu dinheiro."
  imagemSelo="/imagens-padrao/selo-garantia.webp"
/>


<CtaFinal
  titulo="Sua carreira Lash depende dessa decisão"
  subtitulo="Não apenas uma Lash, uma Perfect Lash!"
  imagemFundo="/imagens-curso-tecnico/cta-final-curso-tecnico.webp"
  imagemFundoMobile="/imagens-curso-tecnico/cta-final-curso-tecnico-mobile.webp"
  textoBotaoPrimario="Comprar agora"
  linkBotaoPrimario="https://pay.hotmart.com/D69140627P"
  fundo="preto"
/>




</Layout>