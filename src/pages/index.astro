---
import Layout from '../layouts/Layout.astro';
import HeroSimples from '../components/HeroSimples.astro';
import CardsAcesso from '../components/CardsAcesso.astro';
import SobreThais from '../components/SobreThais.astro';
import { sobreThaisDados } from '../dados/sobreThais.js';
---

<Layout temaHeader="escuro" temaFooter="escuro">

  <HeroSimples
    titulo="Negócios sólidos não acontecem por acaso. Eles são construídos!"
    texto="Mentorias, consultorias e treinamentos para profissionais da beleza que desejam estruturar seus negócios, evoluir com estratégia e crescer de forma eficiente."
    textoBotao="Descubra por onde COMEÇAR"
    link="#cursos"
    imagemFundo="/imagens-home/hero-home.png"
  />

  <CardsAcesso
    cards={[
      {
        titulo: "Estruture seu NEGÓCIO",
        imagem: "/imagens-home/card01-home-mentoria.png",
        textoBotao: "Acessar conteúdo da Mentoria",
        link: "/mentoria",
      },
      {
        titulo: "Aperfeiçoe sua TÉCNICA",
        imagem: "/imagens-home/card02-home-consultoria.png",
        textoBotao: "Acessar conteúdo da Consultoria",
        link: "/consultoria",
      },
      {
        titulo: "Cursos Técnicos e Imersões",
        imagem: "/imagens-home/card03-home-cursos.png",
        textoBotao: "Acessar Cursos e Imersões",
        link: "/perfect-lashes",
      },
    ]}
  />

  <SobreThais {...sobreThaisDados} />

  <section class="bg-(--charcoal) px-6 py-12 md:py-16 text-center">
    <p class="titulo-livre-lovelace font-bold text-[16px] md:text-[20px] tracking-widest text-(--rose-gold) mb-6">
      DIAGNÓSTICO DO SEU NEGÓCIO
    </p>
    <p class="titulo-livre text-[12px] md:text-[16px] text-white opacity-80 max-w-[600px] mx-auto mb-6">
      Preencha o formulário e receba um diagnóstico gratuito sobre o seu negócio Beauty
    </p>
    <a href="#" class="botao-base botao-pri-suave-rose">Quero meu diagnóstico</a>
  </section>

</Layout>