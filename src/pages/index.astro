---
import Layout from '../layouts/Layout.astro';
import HeroHome from '../components/HeroHome.astro';
import FaixaCorrida from '../components/FaixaCorrida.astro';
import DuvidasHome from '../components/DuvidasHome.astro';
import CaminhosHome from '../components/CaminhosHome.astro';
import SobreThais from '../components/SobreThais.astro';
import DiagnosticoHome from '../components/DiagnosticoHome.astro';
import { sobreThaisDados } from '../dados/sobreThais.js';
---

<Layout
  temaHeader="vidro"
  temaFooter="escuro"
  titulo="Curso de Extensão de Cílios e Mentoria para Profissionais da Beleza"
  descricao="Cursos de extensão de cílios online e presenciais em Santa Cruz do Sul, mentoria para negócios de beleza e imersões com a Thaís Grüner."
>

  <Fragment slot="head">
    <link rel="preload" as="image" href="/imagens-home/hero-home-mobile.webp?v=2" media="(max-width: 767px)" fetchpriority="high" />
    <link rel="preload" as="image" href="/imagens-home/hero-home.webp?v=2" media="(min-width: 768px)" fetchpriority="high" />
  </Fragment>

  <HeroHome
    h1="Cursos de extensão de cílios<br>e mentoria para<br>profissionais da beleza"
    nomeEsquerda="Thaís"
    nomeDireita="Grüner"
    foto="/imagens-home/hero-home.webp?v=2"
    fotoMobile="/imagens-home/hero-home-mobile.webp?v=2"
    fotoAlt="Thaís Grüner, educadora em extensão de cílios e mentora de profissionais da beleza"
    textoCanto="Online ou presencial<br>Santa Cruz do Sul<br>10 anos no mercado beauty"
    textoBotao="Onde começar"
    linkBotao="#caminhos"
    textoBotaoLinha="Diagnóstico gratuito"
    linkBotaoLinha="#diagnostico"
  />

  <FaixaCorrida
    itens={[
      "Perfect Lashes",
      "Curso de extensão de cílios",
      "Consultoria para Lash Designers",
      "Imersões Avançadas",
      "M.I.B. Mulheres que Impulsionam Beleza",
      "Mentoria para mulheres empreendedoras",      
    ]}
  />

  <DuvidasHome
    itens={[
      {
        pergunta: "Para quem é a Mentoria M.I.B.?",
        resposta: "Para empresárias da área da beleza que querem organizar seu negócio, fortalecer seu posicionamento e crescer com mais lucratividade e direção.",
      },
      {
        pergunta: "Para quem é o Perfect Lashes?",
        resposta: "É para quem deseja ter a extensão de cílios como sua profissão. Do iniciante ao avançado, da agenda cheia à gestão.",
      },
      {
        pergunta: "Já sou Lash Designer. Serve para mim?",
        resposta: "Sim. A modalidade consultoria técnica é para quem já atua e quer evoluir com acompanhamento.",
      },
      {
        pergunta: "É online ou presencial?",
        resposta: "Os dois: tanto o Perfect Lashes como a M.I.B. têm as opções online, de qualquer lugar, ou presencial em Santa Cruz do Sul.",
      },
    ]}
  />

  <CaminhosHome
    etiqueta="Por onde começar"
    itens={[
      {
        titulo: "Mentoria M.I.B.",
        texto: "Estruture e faça crescer o seu negócio na beleza.",
        imagem: "/imagens-home/card01-home-mentoria.webp?v=2",
        alt: "Mentoria M.I.B. para profissionais da beleza",
        link: "/mentoria",
      },
      {
        titulo: "Cursos Perfect Lashes",
        texto: "Técnica completa, online ou presencial com acompanhamento VIP.",
        imagem: "/imagens-home/card02-home-cursos.webp",
        alt: "Curso de extensão de cílios Perfect Lashes",
        link: "/curso-tecnico-perfect-lashes",
      },
      {
        titulo: "Imersões Online",
        texto: "Saúde ocular e tricologia, E-Books e negócios",
        imagem: "/imagens-home/card03-home-imersoes.webp",
        alt: "Imersões em saúde ocular e tricologia para lash designers",
        link: "/perfect-lashes",
      },
    ]}
  />

  <SobreThais {...sobreThaisDados} />

  <DiagnosticoHome
    etiqueta="Diagnóstico gratuito"
    titulo="Todo negócio pode crescer."
    tituloDestaque="A diferença está em saber por onde começar."
    texto="Preencha o formulário e receba um diagnóstico gratuito sobre o seu negócio beauty."
    textoBotao="Quero meu diagnóstico"
    link="https://tally.so/r/2EdaNe"
  />

</Layout>
