---
import Layout from '../layouts/Layout.astro';
import HeroSplit from '../components/HeroSplit.astro';
import SobreThais from '../components/SobreThais.astro';
import Depoimentos from '../components/Depoimentos.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { sobreThaisDados } from '../dados/sobreThais.js';

const pilares = [
  { numero: "01", titulo: "Posicionamento", subtitulo: "Seja escolhida pelo valor, não pelo preço.", texto: "Construa um posicionamento forte, comunicando seu diferencial e se tornando referência para quem você DESEJA atender." },
  { numero: "02", titulo: "Finanças", subtitulo: "Assuma o controle financeiro do seu negócio.", texto: "Precifique com segurança, organize seus números e tome decisões baseadas em estratégia, não em achismos."},
  { numero: "03", titulo: "Atração e Vendas", subtitulo: "Atraia as clientes certas e venda com confiança.", texto: "Tenha uma comunicação capaz de gerar interesse, conexão e conversão, sem depender de descontos para fechar vendas." },
  { numero: "04", titulo: "Atendimento Encantador", subtitulo: "Transforme cada atendimento em uma experiência memorável.", texto: "Crie processos que aumentam a percepção de valor, fortalecem a confiança e fazem suas clientes voltar sempre!" },
  { numero: "05", titulo: "Fidelização de Clientes", subtitulo: "Construa relacionamentos que geram recorrência.", texto: "Domine estratégias para aumentar retenção, indicações e o valor de cada cliente ao longo do tempo." },
  { numero: "06", titulo: "Aceleração de Lucros", subtitulo: "Cresça com previsibilidade e sustentabilidade.", texto: "Estruture seu negócio para aumentar resultados de forma consistente, sem depender apenas de trabalhar mais horas." },
];
---

<Layout temaHeader="escuro" temaFooter="escuro">


 <HeroSplit
  tema="escuro"
  badge="Mulheres que Impulsionam Beleza"
  siglaDestaque="M.I.B"
  titulo="Você domina a técnica. Agora é hora de "
  tituloDestaque=" desenvolver a empresária "
  tituloFinal="que existe em você!"
  texto=""
  textoApoio="Para você, profissional da beleza, que deseja organizar seu negócio, fortalecer seu posicionamento e crescer com mais previsibilidade, lucratividade e direção."
  textoBotaoPrimario="Quero meu diagnóstico"
  textoBotaoSecundario="Agendar reunião estratégica"
  linkBotaoPrimario="#"
  linkBotaoSecundario="https://wa.me/5551995183025?text=Ol%C3%A1%20Tha%C3%ADs.%0AGostaria%20de%20receber%20informa%C3%A7%C3%B5es%20sobre%20a%20mentoria%20M.I.B."
  microtexto="Vagas limitadas mediante aprovação"
  imagem="/imagens-mentoria/hero-thais-mentoria.png"
/>



  <section class="mentoria-statement">
  <hr class="mentoria-statement-line" />
  <p class="mentoria-statement-text titulo-livre-lovelace-italic text-[24px] md:text-[32px] text-(--charcoal)">
    O crescimento do seu negócio começa quando você deixa de pensar apenas como profissional e passa a agir como empresária.
  </p>
  <hr class="mentoria-statement-line" />
  
</section>




  <section class="mentoria-audience px-6 py-16 md:py-[70px]">
  <h2 class="titulo-livre-lovelace-bold text-center text-[24px] md:text-[32px] tracking-widest text-(--rose-gold) mb-12">
    PARA QUEM É A M.I.B.
  </h2>

  <div class="grid md:grid-cols-2 gap-10 md:gap-[60px] max-w-[1100px] mx-auto">
    <div>
      <h3 class="texto-livre-bold text-[16px] tracking-widest text-(--rose-gold) mb-4">O M.I.B. é para mulheres que</h3>
      <hr class="mentoria-audience-col-line border-(--rose-gold) mb-6" />
      <ul class="space-y-4">
        <li class="flex items-start gap-3">
          <span class="text-(--rose-gold) flex-shrink-0">✓</span>
          <span class="texto-livre text-[13px] text-white leading-relaxed">Estão PRONTAS para assumir o papel de empresárias, sem abrir mão da qualidade e da essência do seu trabalho;</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-(--rose-gold) flex-shrink-0">✓</span>
          <span class="texto-livre text-[13px] text-white leading-relaxed">Já perceberam que dominar a técnica, sozinho, não garante um negócio lucrativo;</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-(--rose-gold) flex-shrink-0">✓</span>
          <span class="texto-livre text-[13px] text-white leading-relaxed">Querem ser reconhecidas pelo valor do seu trabalho, sem precisar competir por preço;</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-(--rose-gold) flex-shrink-0">✓</span>
          <span class="texto-livre text-[13px] text-white leading-relaxed">Desejam construir uma empresa organizada, previsível e preparada para crescer;</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-(--rose-gold) flex-shrink-0">✓</span>
          <span class="texto-livre text-[13px] text-white leading-relaxed">Acreditam que crescer é consequência de estratégia, estrutura e desenvolvimento contínuo.</span>
        </li>        
      </ul>
    </div>

    <div>
      <h3 class="texto-livre-bold text-[16px] tracking-widest text-(--blood-red) mb-4">A MIB não é para você que</h3>
      <hr class="mentoria-audience-col-line border-(--blood-red) mb-6" />
      <ul class="space-y-4">
        <li class="flex items-start gap-3 opacity-70">
          <span class="text-(--blood-red) flex-shrink-0">×</span>
          <span class="texto-livre text-[13px] text-white leading-relaxed">Procuram soluções rápidas sem disposição para colocar em práticA;</span>
        </li>
        <li class="flex items-start gap-3 opacity-70">
          <span class="text-(--blood-red) flex-shrink-0">×</span>
          <span class="texto-livre text-[13px] text-white leading-relaxed">Acreditam que apenas trabalhar mais resolverá os problemas do negócio;</span>
        </li>
        <li class="flex items-start gap-3 opacity-70">
          <span class="text-(--blood-red) flex-shrink-0">×</span>
          <span class="texto-livre text-[13px] text-white leading-relaxed">Buscam somente novas técnicas, sem interesse em desenvolver a empresa;</span>
        </li>
        <li class="flex items-start gap-3 opacity-70">
          <span class="text-(--blood-red) flex-shrink-0">×</span>
          <span class="texto-livre text-[13px] text-white leading-relaxed">Não estão dispostas a assumir uma postura estratégica diante do próprio negócio;</span>
        </li>
              </ul>
    </div>
  </div>

  <div class="mentoria-audience-cta max-w-[640px] mx-auto mt-12 p-6 text-center">
    <p class="titulo-livre-lovelace italic text-[18px] md:text-[21px] text-(--rose-gold) mb-5">
      Se você se reconheceu, é hora de se tornar a próxima Agente MIB.
    </p>
    <div class="flex justify-center">
      <a href="#" class="botao-base botao-pri-suave-rose">Quero meu diagnóstico</a>
    </div>
  </div>
</section>
 



<section class="mentoria-pillars-grid-section px-6 pb-16 md:pb-[70px]">
  <hr class="mentoria-pillars-divider max-w-[760px] mx-auto mb-12" />
  <div class="mentoria-pillars-grid grid grid-cols-1 md:grid-cols-2 gap-5 max-w-[900px] mx-auto">
    {pilares.map((pilar) => (
      <div class="mentoria-pillar-card px-5 py-3">
        <div class="flex items-baseline gap-2 mb-2.5">
          <span class="titulo-livre-lovelace-bold text-[12px] text-(--rose-gold)">{pilar.numero}</span>
          <h3 class="titulo-livre-lovelace-bold text-[16px] text-(--rose-gold)">{pilar.titulo}</h3>
        </div>
        <p class="texto-livre-bold text-[14px] leading-relaxed text-(--rose-gold)">{pilar.subtitulo}</p>
        <p class="texto-livre text-[12px] text-white opacity-70 leading-relaxed">{pilar.texto}</p>
      </div>
    ))}
  </div>
</section>




  <SobreThais {...sobreThaisDados} />

  <Depoimentos
    titulo="Depoimentos"
    depoimentos={[]}
  />


  
<section class="mentoria-final px-6 pt-16 pb-6 md:pt-[90px] md:pb-8 text-center">
  <p class="titulo-livre-lovelace-bold text-[20px] md:text-[30px] tracking-widest text-(--rose-gold) mb-10">
  DAR O PRÓXIMO PASSO DO SEU NEGÓCIO
</p>

  <div class="mentoria-final-frame max-w-[680px] mx-auto p-8 mb-12">
    <p class="texto-livre-italic text-[16px] md:text-[20px] text-white leading-relaxed mb-3 relative z-10">
      e acelerar esse caminho com um método estruturado e acompanhamento estratégico
    </p>
    <p class="titulo-livre-lovelace-bold text-[20px] md:text-[26px] tracking-wide text-(--rose-gold) relative z-10">
      SÓ DEPENDE DE VOCÊ.
    </p>
  </div>
</section>





<CtaFinal
  imagemFundo="/imagens-mentoria/oculos-cta-mentoria.png"
  imagemFundoMobile="/imagens-mentoria/oculos-cta-mentoria-mobile.png"
  textoBotaoPrimario="Quero meu diagnóstico"
  textoBotaoSecundario="Agendar reunião estratégica"
  linkBotaoPrimario="#"
  linkBotaoSecundario="https://wa.me/5551995183025?text=Ol%C3%A1%20Tha%C3%ADs.%0AGostaria%20de%20receber%20informa%C3%A7%C3%B5es%20sobre%20a%20mentoria%20M.I.B."
/>

</Layout>




<script>
  (function () {
    var target = document.querySelector('.mentoria-statement');
    if (!target) return;

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-in');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3 });

    observer.observe(target);
  })();
</script>