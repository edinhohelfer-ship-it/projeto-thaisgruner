    link="https://wa.me/5551995183025?text=Oi%20Tha%C3%ADs.%20Preenchi%20o%20formul%C3%A1rio%20da%20M.I.B%20mas%20j%C3%A1%20gostaria%20de%20conversar%20a%20respeito%20da%20mentoria."
    imagemFundo="/imagens-padrao/obrigado.png"
    imagemFundoMobile="/imagens-padrao/obrigado-mobile.png"
  />

</Layout>

